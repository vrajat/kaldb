ASTRA_CLUSTER_NAME=ASTRA_nrt_bench
ASTRA_CLUSTER_ENV=local
ASTRA_METADATA_MODE=ZOOKEEPER_EXCLUSIVE
ASTRA_ZK_PATH_PREFIX=ASTRA_NRT_BENCH

KAFKA_TOPIC=nrt-bench-topic
KAFKA_TOPIC_PARTITION=0
KAFKA_CLIENT_GROUP=ASTRA-nrt-bench

S3_BUCKET=nrt-bench-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_PREFIX=

INDEXER_NRT_ENABLED=true
INDEXER_ENABLE_FULL_TEXT_SEARCH=true
INDEXER_COMMIT_DURATION_SECS=2
INDEXER_REFRESH_DURATION_SECS=2
INDEXER_MAX_BYTES_PER_CHUNK=50000000
INDEXER_MAX_MESSAGES_PER_CHUNK=250000
INDEXER_MAX_CHUNKS_ON_DISK=5
INDEXER_MAX_OFFSET_DELAY_MESSAGES=5000000
INDEXER_READ_FROM_LOCATION_ON_START=LATEST

ASTRA_CACHE_REPLICA_SET=rep1
ASTRA_MANAGER_REPLICA_SETS=rep1
ASTRA_CACHE_SLOTS_PER_INSTANCE=12
ASTRA_CACHE_CAPACITY_BYTES=0

ASTRA_MANAGER_INITIAL_DELAY_MINS=0
ASTRA_MANAGER_REPLICAS_PERIOD_MINS=1
ASTRA_MANAGER_CACHE_SLOT_PERIOD_MINS=1
ASTRA_MANAGER_ASSIGNMENT_PERIOD_MINS=1
ASTRA_MANAGER_SEARCHABILITY_PERIOD_MINS=1
ASTRA_MANAGER_SNAPSHOT_DELETE_PERIOD_MINS=60
ASTRA_MANAGER_REPLICA_EVICT_PERIOD_MINS=15
ASTRA_MANAGER_REPLICA_DELETE_PERIOD_MINS=15
ASTRA_MANAGER_RECOVERY_PERIOD_MINS=1

ASTRA_QUERY_DEFAULT_QUERY_TIMEOUT_MS=3000
ASTRA_CACHE_DEFAULT_QUERY_TIMEOUT_MS=2500
ASTRA_INDEX_DEFAULT_QUERY_TIMEOUT_MS=2500
